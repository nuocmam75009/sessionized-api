# Copie ce fichier en `.env` et remplis les valeurs.
# Voir la section "Lancer en développement" du README pour le détail de chaque variable.

# --- Base de données (obligatoire) ---
# Base partagée Neon : récupère les deux valeurs avec `npx neon@latest env pull`
# (après `neon link` sur le projet Sessionized), ou demande-les à un membre de l'équipe.
# Base locale : lance `npx prisma dev --detach`, la commande affiche directement l'URL à coller ici.
DATABASE_URL=""
# Utilisée uniquement par `npm run migrate:dev` / `migrate:deploy` (connexion directe,
# nécessaire pour Prisma Migrate). Pas nécessaire si tu utilises `prisma dev` en local.
DATABASE_URL_UNPOOLED=""

# --- JWT (obligatoire) ---
# Génère une valeur avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- Serveur (optionnel, défaut 3000) ---
# Les frontends (voir README) attendent l'API sur 3001.
PORT=3001

# --- Strava (optionnel — uniquement pour tester /strava/*) ---
# Créer une app sur https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3001/strava/callback"

# --- Redirection post-callback Strava (optionnel, défaut http://localhost:3000) ---
ATHLETE_APP_URL="http://localhost:3000"
