// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATHLETE
  COACH
}

enum ActivitySource {
  FIT
  COROS
}

enum WarningFamily {
  INTENSITY
  LOAD
  PATTERN
  RECOVERY
}

enum WarningSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athleteProfile AthleteProfile?
  coachProfile   CoachProfile?
}

model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  coachId String?
  coach   CoachProfile? @relation(fields: [coachId], references: [id])

  corosToken      CorosToken?
  subscriptions   Subscription[]
  activities      Activity[]
  plannedSessions PlannedSession[]
  trainingLoads   TrainingLoad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeAccountId   String?
  monthlyPriceCents Int?

  athletes        AthleteProfile[]
  plannedSessions PlannedSession[]
  subscriptions   Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CorosToken {
  id String @id @default(cuid())

  athleteId String         @unique
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id])

  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  source   ActivitySource
  fileHash String

  sport    String?
  subSport String?

  startedAt        DateTime
  totalDistanceM   Float
  totalDurationSec Int

  avgHeartRate   Int?
  maxHeartRate   Int?
  avgCadence     Int?
  avgPower       Int?
  totalCalories  Int?
  elevationGainM Float?
  elevationLossM Float?

  plannedSessionId String?         @unique
  plannedSession   PlannedSession? @relation(fields: [plannedSessionId], references: [id])

  laps        Lap[]
  trackPoints TrackPoint[]
  warnings    Warning[]

  createdAt DateTime @default(now())

  @@unique([athleteId, fileHash])
}

model Lap {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  index           Int
  distanceM       Float
  durationSec     Float
  avgPaceSecPerKm Float?
  avgHeartRate    Int?
  maxHeartRate    Int?
  avgCadence      Int?
  avgPower        Int?

  avgStanceTimeMs          Float?
  avgVerticalOscillationMm Float?
  avgVerticalRatio         Float?
  avgStepLengthMm          Float?

  @@unique([activityId, index])
}

model TrackPoint {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  timestamp    DateTime
  elapsedSec   Float
  distanceM    Float?
  latitude     Float?
  longitude    Float?
  altitudeM    Float?
  heartRate    Int?
  cadence      Int?
  power        Int?
  speedMPerSec Float?

  @@index([activityId, elapsedSec])
}

model PlannedSession {
  id String @id @default(cuid())

  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id])

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  title         String
  scheduledDate DateTime

  plannedLaps PlannedLap[]
  activity    Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlannedLap {
  id               String         @id @default(cuid())
  plannedSessionId String
  plannedSession   PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)

  index              Int
  targetDistanceM    Float?
  targetPaceSecPerKm Float?
  targetDurationSec  Float?

  @@unique([plannedSessionId, index])
}

model Warning {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  family     WarningFamily
  severity   WarningSeverity
  message    String
  suggestion String?

  createdAt DateTime @default(now())
}

model TrainingLoad {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  date DateTime
  ctl  Float
  atl  Float
  tsb  Float

  createdAt DateTime @default(now())

  @@unique([athleteId, date])
}
