// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATHLETE
  COACH
}

enum ActivitySource {
  FIT
  COROS
  STRAVA
}

enum WarningFamily {
  INTENSITY
  LOAD
  PATTERN
  RECOVERY
}

enum WarningSeverity {
  INFO
  WARNING
  CRITICAL
}

enum HeartRateZone {
  Z1
  Z2
  Z3
  Z4
  Z5
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AthleteSpecialty {
  TRAIL
  ULTRA_TRAIL
  MIDDLE_DISTANCE_TRACK
  MIDDLE_DISTANCE_ROAD
  LONG_DISTANCE_TRACK
  LONG_DISTANCE_ROAD
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athleteProfile AthleteProfile?
  coachProfile   CoachProfile?
  messages       Message[]
}

model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  coachId String?
  coach   CoachProfile? @relation(fields: [coachId], references: [id])

  // Remplis par l'athlète lui-même (formulaire profil).
  age                    Int?
  weightKg               Float?
  heightCm               Float?
  basalMetabolicRateKcal Int?
  specialty              AthleteSpecialty?

  // Synchronisées depuis Strava (`GET /athlete/zones`, cf. StravaService.syncZones) —
  // pas modifiables par l'athlète. Bornes hautes par zone, Z1 -> dernière ; la dernière
  // zone Strava est ouverte (pas de max), on y recopie sa borne basse faute de plafond réel.
  heartRateZonesBpm Int[]   @default([])
  paceZonesSecPerKm Float[] @default([])

  corosToken    CorosToken?
  stravaToken   StravaToken?
  subscriptions Subscription[]
  activities    Activity[]
  plans         Plan[]
  trainingLoads TrainingLoad[]
  conversations Conversation[]
  coachRatings  CoachRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  age         Int?
  description String?
  specialty   String?
  rating      Float?

  stripeAccountId   String?
  monthlyPriceCents Int?

  athletes      AthleteProfile[]
  plans         Plan[]
  subscriptions Subscription[]
  conversations Conversation[]
  ratings       CoachRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachRating {
  id String @id @default(cuid())

  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  value Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coachId, athleteId])
}

model CorosToken {
  id String @id @default(cuid())

  athleteId String         @unique
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StravaToken {
  id String @id @default(cuid())

  athleteId String         @unique
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id])

  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  source           ActivitySource
  fileHash         String
  stravaActivityId String?

  fitFileData Bytes?
  gpxFileData Bytes?

  sport    String?
  subSport String?

  startedAt        DateTime
  totalDistanceM   Float
  totalDurationSec Int

  avgHeartRate   Int?
  maxHeartRate   Int?
  avgCadence     Int?
  avgPower       Int?
  totalCalories  Int?
  elevationGainM Float?
  elevationLossM Float?

  athleteNote    String?
  difficultyNote Int?

  workoutId String?  @unique
  workout   Workout? @relation(fields: [workoutId], references: [id])

  laps        Lap[]
  trackPoints TrackPoint[]
  routePoints RoutePoint[]
  warnings    Warning[]

  createdAt DateTime @default(now())

  @@unique([athleteId, fileHash])
}

model Lap {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  index           Int
  distanceM       Float
  durationSec     Float
  avgPaceSecPerKm Float?
  avgHeartRate    Int?
  maxHeartRate    Int?
  avgCadence      Int?
  avgPower        Int?

  avgStanceTimeMs          Float?
  avgVerticalOscillationMm Float?
  avgVerticalRatio         Float?
  avgStepLengthMm          Float?

  @@unique([activityId, index])
}

model TrackPoint {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  timestamp    DateTime
  elapsedSec   Float
  distanceM    Float?
  latitude     Float?
  longitude    Float?
  altitudeM    Float?
  heartRate    Int?
  cadence      Int?
  power        Int?
  speedMPerSec Float?

  @@index([activityId, elapsedSec])
}

model RoutePoint {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  timestamp DateTime?
  latitude  Float
  longitude Float
  altitudeM Float?

  @@index([activityId])
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Plan {
  id String @id @default(cuid())

  // Enregistrement figé de qui coachait pendant ce bloc : peut différer du coach
  // actuel de l'athlète (AthleteProfile.coachId) si la relation a changé depuis.
  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  // Plus @unique : un athlète accumule plusieurs plans dans le temps (historique).
  // Un seul ACTIVE à la fois par athlète, appliqué au niveau applicatif (PlansService.create).
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  status     PlanStatus @default(ACTIVE)
  startDate  DateTime
  endDate    DateTime?
  objective1 String?
  objective2 String?

  workouts Workout[]
  raceDays RaceDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RaceDay {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  title String
  date  DateTime
}

model Workout {
  id String @id @default(cuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  title         String
  scheduledDate DateTime

  coachNote           String?
  targetDistanceM     Float?
  targetDurationSec   Float?
  targetHeartRateZone HeartRateZone?

  laps     WorkoutLap[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkoutLap {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  index               Int
  targetDistanceM     Float?
  targetPaceSecPerKm  Float?
  targetDurationSec   Float?
  targetHeartRateZone HeartRateZone?

  @@unique([workoutId, index])
}

model Warning {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  family     WarningFamily
  severity   WarningSeverity
  message    String
  suggestion String?

  createdAt DateTime @default(now())
}

model TrainingLoad {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  date DateTime
  ctl  Float
  atl  Float
  tsb  Float

  createdAt DateTime @default(now())

  @@unique([athleteId, date])
}

model Conversation {
  id String @id @default(cuid())

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  messages      Message[]
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, coachId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content  String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
}
